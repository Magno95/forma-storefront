# Dedicated container ID per deployment environment.
NEXT_PUBLIC_GTM_ID=
# Server-only key for the private storefront. Generate with the README command.
SITE_ACCESS_KEY=
# Canonical production origin (without trailing slash).
SITE_URL=https://forma.davidemagnoni.it
# Default is "normal"; also supports "instant", "slow", "error".
MOCK_SCENARIO=normal
# Only used with MOCK_SCENARIO=error: catalog, cart, payment-options, checkout.
MOCK_FAIL_OPERATION=
# Optional HTTPS delivery for already optimized hero media.
FORMA_HERO_DESKTOP_URL=
FORMA_HERO_MOBILE_URL=
